{"v":1,"id":"mvemcaqa-mi4e","mode":"optimize","formulaName":"My formula","code":"\n_SECTION_BEGIN(\"SMA Crossover Optimization\");\n\n// Optimize the fast SMA period\nFastPeriod = Optimize(\"Fast SMA\", 50, 20, 100, 5);\n//SlowPeriod = Optimize(\"Slow SMA\", 200, 100, 200, 25);\n//ExitPeriod = Optimize(\"Exit SMA\", 100, 20, 200, 20);\n\n\n// Fixed moving averages\nFastSMA = MA(Close, FastPeriod);\nSlowSMA = MA(Close, 200);\nExitSMA = MA(Close, 100);\n\n// Buy when fast SMA crosses above SMA 200\nBuy = Cross(FastSMA, SlowSMA);\n\n// Sell when closing price falls below SMA 100\nSell = Cross(ExitSMA, Close);\n\n// Remove repeated signals\nBuy = ExRem(Buy, Sell);\nSell = ExRem(Sell, Buy);\n\n// Plot moving averages\nPlot(Close, \"Close\", colorDefault, styleCandle);\nPlot(FastSMA, \"Fast SMA\", colorGreen, styleLine);\nPlot(SlowSMA, \"SMA 200\", colorRed, styleLine);\nPlot(ExitSMA, \"SMA 100\", colorBlue, styleLine);\n\n// Exploration columns\nFilter = Buy OR Sell;\nAddColumn(Close, \"Close\", 1.2);\nAddColumn(FastSMA, \"Fast SMA\", 1.2);\nAddColumn(SlowSMA, \"SMA 200\", 1.2);\nAddColumn(ExitSMA, \"SMA 100\", 1.2);\nAddColumn(Buy, \"Buy\", 1.0);\nAddColumn(Sell, \"Sell\", 1.0);\n\n_SECTION_END();","symbols":["BALKRISIND","BHARATFORG","BOSCHLTD","CEATLTD","CRAFTSMAN","EXIDEIND","GUJTHEM","HCL-INSYS","JAMNAAUTO","JIOFIN","JKTYRE","MOTHERSON","MRF","RELIANCE","SONACOMS","TUBEINVEST","TVSMOTOR"],"interval":"D","range":{"mode":"all","n":1,"from":null,"to":null},"settings":{"general":{"initialEquity":100000,"positions":"long","futuresMode":false,"minShares":1,"minPosValue":0,"accountMargin":100,"interestRate":0,"allowPositionShrinking":false,"activateStopsImmediately":false,"roundLotSize":0,"tickSize":0,"reverseSignalForcesExit":false,"allowSameBarExit":false,"priceBounds":true,"maxSymbols":500},"trades":{"buyPrice":"open","sellPrice":"open","shortPrice":"close","coverPrice":"close","buyDelay":1,"sellDelay":1,"shortDelay":0,"coverDelay":0},"stops":{"maxLoss":{"on":true,"amou