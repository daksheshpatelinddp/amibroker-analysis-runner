{"v":1,"id":"mwnmzjw8-df00","mode":"backtest","formulaName":"My formula","code":"\n_SECTION_BEGIN(\"SMA Crossover Optimization\");\n\n// Optimize the fast SMA period\nFastPeriod = Optimize(\"Fast SMA\", 20, 20, 200, 1);\nSlowPeriod = Optimize(\"Slow SMA\", 130, 100, 200, 5);\nExitPeriod = Optimize(\"Exit SMA\", 30, 20, 200, 5);\n\n\n// Fixed moving averages\nFastSMA = MA(Close, FastPeriod);\nSlowSMA = MA(Close, SlowPeriod);\nExitSMA = MA(Close, ExitPeriod);\n\n// Buy when fast SMA crosses above SMA 200\nBuy = Cross(FastSMA, SlowSMA);\n\n// Sell when closing price falls below SMA 100\nSell = Cross(ExitSMA, Close);\n\n// Remove repeated signals\nBuy = ExRem(Buy, Sell);\nSell = ExRem(Sell, Buy);\n\n\n\n\n// Plot moving averages\nPlot(Close, \"Close\", colorDefault, styleCandle);\nPlot(FastSMA, \"Fast SMA\", colorGreen, styleLine);\nPlot(SlowSMA, \"SMA 200\", colorRed, styleLine);\nPlot(ExitSMA, \"SMA 100\", colorBlue, styleLine);\n\n\n// Exploration columns\nFilter = Buy OR Sell;\nAddColumn(Close, \"Close\", 1.2);\nAddColumn(FastSMA, \"Fast SMA\", 1.2);\nAddColumn(SlowSMA, \"SMA 200\", 1.2);\nAddColumn(ExitSMA, \"SMA 100\", 1.2);\nAddColumn(Buy, \"Buy\", 1.0);\nAddColumn(Sell, \"Sell\", 1.0);\n\n_SECTION_END();","symbols":["ADANIENT","ADANIPORTS","APOLLOHOSP","ASIANPAINT","AXISBANK","BAJAJ-AUTO","BAJAJFINSV","BAJFINANCE","BEL","BHARTIARTL","CIPLA","COALINDIA","DRREDDY","EICHERMOT","ETERNAL","GRASIM","HCLTECH","HDFCBANK","HDFCLIFE","HINDALCO","HINDUNILVR","ICICIBANK","INDIGO","INFY","ITC","JIOFIN","JSWSTEEL","KOTAKBANK","LT","M&M","MARUTI","MAXHEALTH","NESTLEIND","NTPC","ONGC","POWERGRID","RELIANCE","SBILIFE","SBIN","SHRIRAMFIN","SUNPHARMA","TATACONSUM","TATASTEEL","TCS","TECHM","TITAN","TMPV","TRENT","ULTRACEMCO"],"interval":"D","range":{"mode":"dates","n":1,"from":"2016-06-03","to":"2016-06-04"},"settings":{"general":{"initialEquity":100000,"positions":"long","futuresMode":false,"minShares":1,"minPosValue":0,"accountMargin":100,"interestRate":0,"allowPositionShrinking