{"v":1,"id":"mvn5tq4k-ywd9","mode":"optimize","formulaName":"Rakesh pujara momentum stategy","code":"//==============================================================\n//  Rakesh Pujara Momentum Strategy - Complete Version\n//  Entry  : Weekly Close above Bollinger Upper Band (50, 2)\n//  Exit 1 : Initial 20% Stop Loss\n//  Exit 2 : Close below 100-week EMA\n//  Exit 3 : ATR Trailing Stop (ATR 14 × 1.8)\n//==============================================================\n\n_SECTION_BEGIN(\"Rakesh Pujara Full Strategy\");\n\n//==================== PARAMETERS ====================\nBB_Period      = Optimize(\"BB Period\", 50, 20, 50, 1);\nBB_Dev         = Optimize(\"BB Deviation\", 2.0 , 2.0, 4.0, 0.1);\nEMA_Exit_Period = Optimize(\"Exit EMA Period (Weekly)\", 100, 50, 100, 10);\nATR_Period     = param(\"ATR Period\", 14, 10, 20, 1);\nATR_Mult       = Param(\"ATR Multiplier\", 1.8, 1.0, 2.0, 0.1);\nInitial_SL_Pct = Optimize(\"Initial SL %\", 20, 10, 20, 5);\n\n//==================== INDICATORS ====================\n// Bollinger Bands for Entry\nMidBB   = MA(C, BB_Period);\nStdDev  = StDev(C, BB_Period);\nUpperBB = MidBB + BB_Dev * StdDev;\nLowerBB = MidBB - BB_Dev * StdDev;\n\n// 100-week MA for Exit\nEMA100 = MA(C, EMA_Exit_Period);\n\n// ATR for Trailing Stop\nATR14 = ATR(ATR_Period);\n\n//==================== ENTRY ====================\nBuySetup = Cross(C, UpperBB);          // Weekly Close above Upper Band\nBuy      = Ref(BuySetup, -1);          // Enter next bar (Monday)\n\n//==================== EXIT CONDITIONS ====================\n\n// 1. Initial 20% Stop Loss\nEntryPrice = ValueWhen(Buy, BuyPrice);\nInitialSL  = EntryPrice * (1 - Initial_SL_Pct/100);\nExit1_SL   = C < InitialSL;\n\n// 2. Close below 100-week Expotential Moving Average\nExit2_EMA   = Cross(EMA100, C);           // Close crosses below 100 MA\n\n// 3. ATR Trailing Stop (Chandelier style - highest high since entry)\nHighestSinceEntry = HighestSince(Buy, H);\nATR_Trail         = HighestSinceEntry - (ATR_Mult * ATR14);\nExit3_ATR         = Cross(ATR_Trail, C);   // Close crosses below ATR trail\n\n// Final Sell = Any one of the three conditions\nSell = Exit1_SL OR Exit2_EMA OR Exit3_ATR;\n\n// Clean signals\nBuy  = ExRem(Buy, Sell);\nSell = ExRem(Sell, Buy);\n\n//==================== PLOTTING ====================\nSetChartOptions(0, chartShowArrows | chartShowDates);\n_N(Title = StrFormat(\"{{NAME}} - {{INTERVAL}} {{DATE}}  Close %g  {{VALUES}}\", C));\n\nPlot(C, \"Close\", colorDefault, styleCandle);\n\n// Bollinger Bands\nPlot(UpperBB, \"Upper BB (3.7)\", colorBrightGreen, styleThick);\nPlot(MidBB, \"Mid BB\", colorYellow, styleThick);\nPlot(LowerBB, \"Lower BB\", colorRed, styleThick);\n\n// 100-week MA\nPlot(EMA100, \"100-Week MA\", colorOrange, styleThick);\n\n// ATR Trailing Stop line (only when in trade)\nTrailLine = IIf(BarsSince(Buy) < BarsSince(Sell), ATR_Trail, Null);\nPlot(TrailLine, \"ATR Trail (1.8)\", colorAqua, styleThick | styleDots);\n\n// Arrows\nPlotShapes(IIf(Buy, shapeUpArrow, shapeNone), colorBrightGreen, 0, L, -40);\nPlotShapes(IIf(Sell, shapeDownArrow, shapeNone), colorRed, 0, H, -40);\n\n//==================== EXPLORATION ====================\nFilter = Buy OR Sell OR BuySetup;\n\nAddColumn(C, \"Close\", 1.2);\nAddColumn(UpperBB, \"Upper BB\", 1.2);\nAddColumn(EMA100, \"100 MA\", 1.2);\nAddColumn(ATR_Trail, \"ATR Trail\", 1.2);\nAddColumn(BuySetup, \"Buy Setup\", 1.0);\nAddColumn(Buy, \"Buy\", 1.0);\nAddColumn(Sell, \"Sell\", 1.0);\nAddColumn(Exit1_SL, \"Exit1-20%SL\", 1.0);\nAddColumn(Exit2_EMA, \"Exit2-100EMA\", 1.0);\nAddColumn(Exit3_ATR, \"Exit3-ATR\", 1.0);\n\n_SECTION_END();","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKE