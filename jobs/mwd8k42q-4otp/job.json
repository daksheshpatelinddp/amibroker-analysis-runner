{"v":1,"id":"mwd8k42q-4otp","mode":"backtest","formulaName":"RakeshPujara_BB_Breakout_Momentum original claude","code":"//==============================================================================\n//  BOLLINGER-BAND BREAKOUT MOMENTUM (Rakesh Pujara style)  -  long only\n//\n//  ENTRY : close breaks above the UPPER Bollinger band (wide band: default 55 bars, 3.7 SD).\n//  EXITS : whichever comes first\n//          1. initial stop: close below entry * (1 - SL%)\n//          2. close below the exit MA\n//          3. ATR trailing stop: (highest high since entry) - ATR * multiple\n//\n//  Run it on the WEEKLY time frame (Analysis -> Time frame = Weekly) to match\n//  the weekly-chart idea. Daily works too but the numbers then mean days.\n//\n//  What I changed from the pasted version, and why:\n//   1. The pasted version computed the stop and the trailing high from the raw\n//      Buy array. A second breakout while you are already holding re-set the\n//      entry price and the highest-high, so the stop moved UP/DOWN wrongly.\n//      This version tracks ONE position in a loop: entry, stop, and highest high\n//      are set once at entry and only the trail can rise.\n//   2. Signals are made on the close and traded at the NEXT open (no double\n//      delay, no look-ahead).\n//   3. Portfolio rules added: equal slots, strongest breakout first.\n//==============================================================================\n_SECTION_BEGIN(\"BB Breakout Momentum\");\nBBper    = Optimize(\"BB period\", 55, 30, 80, 5);\nBBdev    = Optimize(\"BB deviation\", 3.7, 2.5, 4.5, 0.2);\nExitMA   = Optimize(\"Exit MA period\", 23, 15, 40, 5);\nATRper   = Param(\"ATR period\", 14, 5, 30, 1);\nATRmult  = Optimize(\"ATR multiple\", 1.8, 1.2, 2.6, 0.2);\nSLpct    = Param(\"Initial stop %\", 20, 5, 40, 1);\nMaxOpen  = Param(\"Max open positions\", 10, 1, 50, 1);\n_SECTION_END();\n\nMid   = MA( C, BBper );\nUpper = Mid + BBdev * StDev( C, BBper );\nLower = Mid - BBdev * StDev( C, BBper );\nXMA   = MA( C, ExitMA );\nAtrV  = ATR( ATRper );\n\nSetup = Cross( C, Upper );                       // breakout bar (decided at its close)\n\nsigBuy = sigSell = 0 * C;\nTrailLine = Null * C;\ninPos = 0; ePx = 0; hh = 0; stopPx = 0;\n\nfor( b = 1; b < BarCount; b++ )\n{\n    if( ! inPos )\n    {\n        if( Setup[ b ] )\n        {\n            sigBuy[ b ] = 1; inPos = 1;\n            ePx = C[ b ];                              // planned entry ~ this close (real fill = next open)\n            hh = H[ b ];\n            stopPx = ePx * ( 1 - SLpct / 100 );\n        }\n    }\n    else\n    {\n        hh = Max( hh, H[ b ] );\n        tr = hh - ATRmult * AtrV[ b ];\n        TrailLine[ b ] = tr;\n        if( C[ b ] < stopPx OR C[ b ] < XMA[ b ] OR C[ b ] < tr )\n        {\n            sigSell[ b ] = 1; inPos = 0;\n        }\n    }\n}\n\nBuy  = Ref( sigBuy, -1 );\nSell = Ref( sigSell, -1 );\nShort = Cover = 0 * C;\nBuyPrice = SellPrice = O;\n\nSetTradeDelays( 0, 0, 0, 0 );\nSetOption( \"MaxOpenPositions\", MaxOpen );\nSetPositionSize( 100 / MaxOpen, spsPercentOfEquity );\nPositionScore = Ref( 100 * ( C - Upper ) / Upper, -1 );   // how far through the band: strongest first\n\nif( Status( \"action\" ) == actionExplore )\n{\n    Filter = Setup OR sigSell;\n    AddTextColumn( WriteIf( Setup, \"BREAKOUT\", \"EXIT\" ), \"Signal\", 1.0 );\n    AddColumn( C, \"Close\", 1.2 );\n    AddColumn( Upper, \"Upper BB\", 1.2 );\n    AddColumn( XMA, \"Exit MA\", 1.2 );\n    AddColumn( 100 * ( C / Upper - 1 ), \"% above band\", 1.1 );\n}\n\nif( Status( \"action\" ) == actionIndicator )\n{\n    _N( Title = StrFormat( \"{{NAME}} {{DATE}}  Close %g\", C ) );\n    Plot( C, \"Price\", colorDefault, styleCandle );\n    Plot( Upper, \"Upper BB\", colorBrightGreen, styleThick );\n    Plot( Mid, \"Mid BB\", colorYellow, styleLine );\n    Plot( Lower, \"Lower BB\", colorRed, styleLine );\n    Plot( XMA, \"Exit MA\", colorOrange, styleThick );\n    Plot( TrailLine, \"ATR trail\", colorAqua, styleDots | styleThick );\n    PlotShapes( IIf( Buy, shapeUpArrow, shapeNone ), colorBrightGreen, 0, L, -20 );\n    PlotShapes( IIf( Sell, shapeDownArrow, shapeNone ), colorRed, 0, H, -20 );\n}\n","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKEM","ALKYLAMINE","AMAGI","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","ANTHEM","ANURAS","APARINDS","APLAPOLLO","APOLLO","APOLLOHOSP","APOLLOTYRE","APTUS","ARE&M","ARVIND","ARVINDFASN","ASAHIINDIA","ASHAPURMIN","ASHOKA","ASHOKLEY","ASIANPAINT","ASTERDM","ASTRAL","ASTRAMICRO","ATGL","ATHERENERG","ATLANTAELE","ATUL","AUBANK","AURIONPRO","AUROPHARMA","AVALON","AVANTIFEED","AVL","AWL","AXISBANK","AXISCADES","AZAD","BAJAJ-AUTO","BAJAJCON","BAJAJFINSV","BAJAJHFL","BAJAJHLDNG","BAJFINANCE","BALAMINES","BALKRISIND","BALRAMCHIN","BALUFORGE","BANCOINDIA","BANDHANBNK","BANKBARODA","BANKINDIA","BATAINDIA","BBOX","BDL","BECTORFOOD","BEL","BELRISE","BEML","BERGEPAINT","BHARATCOAL","BHARATFORG","BHARTIARTL","BHARTIHEXA","BHEL","BIOCON","BIRLACORPN","BLACKBUCK","BLS","BLUEJET","BLUESTARCO","BLUESTONE","BORORENEW","BOSCHLTD","BPCL","BRIGADE","BRITANNIA","BSOFT","CAMPUS","CAMS","CANBK","CANFINHOME","CANHLIFE","CAPILLARY","CAPLIPOINT","CARBORUNIV","CARTRADE","CASTROLIND","CCL","CDSL","CEATLTD","CEIGALL","CELLO","CEMPRO","CENTRALBK","CENTUM","CERA","CESC","CGCL","CGPOWER","CHALET","CHAMBLFERT","CHENNPETRO","CHOICEIN","CHOLAFIN","CHOLAHLDNG","CIEINDIA","CIPLA","CLEAN","CLEANMAX","CMPDI","CMRGREEN","CMSINFO","COALINDIA","COCHINSHIP","COFORGE","COHANCE","COLPAL","CONCOR","CONCORDBIO","COROMANDEL","CPPLUS","CRAFTSMAN","CRAMC","CREDITACC","CRISIL","CROMPTON","CSBBANK","CUB","CUMMINSIND","CUPID","CYIENT","DABUR","DALBHARAT","DATAMATICS