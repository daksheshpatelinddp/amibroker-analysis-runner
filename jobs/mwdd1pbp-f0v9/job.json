{"v":1,"id":"mwdd1pbp-f0v9","mode":"backtest","formulaName":"Rising 44","code":"//==============================================================\n//  Siddharth Bhanushali - Rising 44 MA Strategy\n//  Updated: Buy only when High > BuyPrice\n//           Short only when Low < ShortPrice\n//==============================================================\n\n_SECTION_BEGIN(\"Rising 44 MA Strategy - Siddharth Bhanushali\");\n\n//========== Parameters ==========\nMA_Period       = Param(\"MA Period\", 44, 20, 100, 1);\nRisingBars      = Param(\"Rising Bars Check\", 3, 1, 10, 1);\nNearMA_Percent  = Param(\"Near MA %\", 1.5, 0.5, 5, 0.1);\nRR_Ratio        = Param(\"Risk Reward Ratio\", 2, 1, 5, 0.5);\nShowShort       = ParamToggle(\"Show Short Side\", \"No|Yes\", 0);\n\n//========== Calculations ==========\nMA44 = MA(C, MA_Period);\n\n// Rising / Falling MA\nRisingMA = True;\nFallingMA = True;\nfor(i = 1; i <= RisingBars; i++)\n{\n    RisingMA  = RisingMA  AND (MA44 > Ref(MA44, -i));\n    FallingMA = FallingMA AND (MA44 < Ref(MA44, -i));\n}\n\n// Support / Resistance zone\nNearMA_Long  = (L <= MA44 * (1 + NearMA_Percent/100)) AND (H >= MA44 * (1 - NearMA_Percent/100));\nNearMA_Short = (H >= MA44 * (1 - NearMA_Percent/100)) AND (L <= MA44 * (1 + NearMA_Percent/100));\n\n// Candle color\nBullishCandle = C > O;\nBearishCandle = C < O;\n\n//========== Signal Candle Detection ==========\nBuySetup   = RisingMA  AND NearMA_Long  AND BullishCandle;\nShortSetup = FallingMA AND NearMA_Short AND BearishCandle;\n\n// Store the levels of the signal candle\nBuyLevel   = ValueWhen(BuySetup, H);     // Buy above this high\nSL_Long    = ValueWhen(BuySetup, L);     // Stop loss below this low\n\nShortLevel = ValueWhen(ShortSetup, L);   // Short below this low\nSL_Short   = ValueWhen(ShortSetup, H);   // Stop loss above this high\n\n//========== Actual Entry Conditions (Your Request) ==========\n// Buy only when High crosses above the BuyLevel of signal candle\nBuy  = Cross(H, BuyLevel) AND BuyLevel > 0;\n\n// Short only when Low crosses below the ShortLevel of signal candle\nShort = IIf(ShowShort, Cross(ShortLevel, L) AND ShortLevel > 0, 0);\n\n// Reset after entry (optional safety)\nBuy  = ExRem(Buy, Short);\nShort = ExRem(Short, Buy);\n\n//========== Exit (Stop Loss + Target) ==========\nSell  = 0;\nCover = 0;\n\nRisk_Long  = BuyLevel - SL_Long;\nRisk_Short = SL_Short - ShortLevel;\n\nApplyStop(stopTypeLoss,   stopModePoint, Risk_Long,  True, False);\nApplyStop(stopTypeProfit, stopModePoint, Risk_Long * RR_Ratio, True, False);\n\n//========== Plotting ==========\nSetChartOptions(0, chartShowArrows | chartShowDates);\n_N(Title = StrFormat(\"{{NAME}} - {{INTERVAL}} {{DATE}}  Open %g, Hi %g, Lo %g, Close %g (%.1f%%) {{VALUES}}\", \n             O, H, L, C, SelectedValue(ROC(C, 1))));\n\nPlot(C, \"Close\", colorDefault, styleNoTitle | styleCandle);\n\n// 44 MA colored\nMA_Color = IIf(RisingMA, colorBrightGreen, IIf(FallingMA, colorRed, colorYellow));\nPlot(MA44, \"44 SMA\", MA_Color, styleThick);\n\n// Plot signal levels (optional visual help)\nPlot(BuyLevel, \"Buy Level\", colorBrightGreen, styleDashed | styleNoRescale);\nPlot(ShortLevel, \"Short Level\", colorRed, styleDashed | styleNoRescale);\n\n// Arrows\nPlotShapes(IIf(BuySetup, shapeSmallUpTriangle, shapeNone), colorBrightGreen, 0, L, -25);  // Setup candle\nPlotShapes(IIf(Buy, shapeUpArrow, shapeNone), colorGreen, 0, L, -45);                      // Actual Buy\n\nPlotShapes(IIf(ShortSetup AND ShowShort, shapeSmallDownTriangle, shapeNone), colorOrange, 0, H, -25);\nPlotShapes(IIf(Short, shapeDownArrow, shapeNone), colorRed, 0, H, -45);\n\n//========== Exploration ==========\nFilter = Buy OR Short OR BuySetup OR (ShortSetup AND ShowShort);\n\nAddColumn(C, \"Close\", 1.2);\nAddColumn(MA44, \"44 MA\", 1.2);\nAddColumn(BuySetup, \"Buy Setup\", 1.0);\nAddColumn(Buy, \"Buy Triggered\", 1.0);\nAddColumn(BuyLevel, \"Buy Above\", 1.2);\nAddColumn(SL_Long, \"SL Long\", 1.2);\nAddColumn(ShortSetup, \"Short Setup\", 1.0);\nAddColumn(Short, \"Short Triggered\", 1.0);\nAddColumn(ShortLevel, \"Short Below\", 1.2);\nAddColumn(SL_Short, \"SL Short\", 1.2);\n\n_SECTION_END();","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKEM","ALKYLAMINE","AMAGI","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","ANTHEM","ANURAS","APARINDS","APLAPOLLO","APOLLO","APOLLOHOSP","APOLLOTYRE","APTUS","ARE&M","ARVIND","ARVINDFASN","ASAHIINDIA","ASHAPURMIN","ASHOKA","ASHOKLEY","ASIANPAINT","ASTERDM","ASTRAL","ASTRAMICRO","ATGL","ATHERENERG","ATLANTAELE","ATUL","AUBANK","AURIONPRO","AUROPHARMA","AVALON","AVANTIFEED","AVL","AWL","AXISBANK","AXISCADES","AZAD","BAJAJ-AUTO","BAJAJCON","BAJAJFINSV","BAJAJHFL","BAJAJHLDNG","BAJFINANCE","BALAMINES","BALKRISIND","BALRAMCHIN","BALUFORGE","BANCOINDIA","BANDHANBNK","BANKBARODA","BANKINDIA","BATAINDIA","BBOX","BDL","BECTORFOOD","BEL","BELRISE","BEML","BERGEPAINT","BHARATCOAL","BHARATFORG","BHARTIARTL","BHARTIHEXA","BHEL","BIOCON","BIRLACORPN","BLACKBUCK","BLS","BLUEJET","BLUESTARCO","BLUESTONE","BORORENEW","BOSCHLTD","BPCL","BRIGADE","BRITANNIA","BSOFT","CAMPUS","CAMS","CANBK","CANFINHOME","CANHLIFE","CAPILLARY","CAPLIPOINT","CARBORUNIV","CARTRADE","CASTROLIND","CCL","CDSL","CEATLTD","CEIGALL","CELLO","CEMPRO","CENTRALBK","CENTUM","CERA","CESC","CGCL","CGPOWER","CHALET","CHAMBLFERT","CHENNPETRO","CHOICEIN","CHOLAFIN","CHOLAHLDNG","CIEINDIA","CIPLA","CLEAN","CLEANMAX","CMPDI","CMRGREEN","CMSINFO","COALINDIA","COCHINSHIP","COFORGE","COHANCE","COLPAL","CONCOR","CONCORDBIO","COROMANDEL","CPPLUS","CRAFTSMAN","CRAMC","CREDITACC","CRISIL","CROMPTON","CSBBANK","CUB","CUMMINSIND","CUPID","CYIENT","DABUR","DALBHARAT","DATAMATICS","DATAPATTNS","DBL","DBREALTY",