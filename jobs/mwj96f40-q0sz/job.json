{"v":1,"id":"mwj96f40-q0sz","mode":"backtest","formulaName":"T11_scale_in_out","code":"// T11  SCALE IN / SCALE OUT (add on a new 20-week high while long, trim on a 3-week low).  NOT SUPPORTED BY THE APP YET - run it in AmiBroker with the DETAIL LOG and send the log, then the feature gets built.\nSetOption(\"InitialEquity\", 100000);\nSetOption(\"CommissionMode\", 1);      // percent of trade\nSetOption(\"CommissionAmount\", 1);    // 1% per side\nSetOption(\"UsePrevBarEquityForPosSizing\", True);\nSetTradeDelays(0, 0, 0, 0);\n\nBuy  = Cross(MA(C, 20), MA(C, 50));\nSell = Cross(MA(C, 50), MA(C, 20));\nBuy = ExRem(Buy, Sell); Sell = ExRem(Sell, Buy);\nInTrade = Flip(Buy, Sell);\nAdd  = InTrade AND C > Ref(HHV(H, 20), -1) AND Ref(InTrade, -1);\nTrim = InTrade AND C < Ref(LLV(L, 3), -1) AND Ref(InTrade, -1);\nBuy  = Buy + sigScaleIn  * Add;\nSell = Sell + sigScaleOut * Trim;\nBuyPrice = SellPrice = O;\nSetTradeDelays(1, 1, 1, 1);\nSetOption(\"MaxOpenPositions\", 15);\nSetPositionSize(5, spsPercentOfEquity);\nPositionScore = ROC(C, 20);\n","symbols":["JAYNECOIND"],"interval":"W","range":{"mode":"dates","n":1,"from":"2000-01-01","to":"2026-11-07"},"settings":{"general":{"initialEquity":100000,"positions":"both","futuresMode":false,"minShares":1,"minPosValue":0,"accountMargin":100,"interestRate":0,"allowPositionShrinking":false,"activateStopsImmediately":false,"roundLotSize":0,"tickSize":0,"reverseSignalForcesExit":false,"allowSameBarExit":false,"reenterSameBar":false,"priceBounds":false,"padAlign":false,"padRef":"^NIFTY50 ","maxSymbols":0},"trades":{"buyPrice":"open","sellPrice":"open","shortPrice":"close","coverPrice":"close","buyDelay":0,"sellDelay":0,"shortDelay":0,"coverDelay":0},"stops":{"maxLoss":{"on":false,"amount":20,"mode":1,"exitAt":2},"profit":{"on":false,"amount":20,"mode":1,"exitAt":0},"trail":{"on":false,"amount":10,"mode":1,"exitAt":1},"nbar":{"on":false,"amount":8},"reentryDelay":0},"commission":{"mode":1,"amount":0,"table":{"default":{"type":"pct","amou