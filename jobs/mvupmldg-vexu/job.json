{"v":1,"id":"mvupmldg-vexu","mode":"scan","formulaName":"ALOK JAIN MOMENTUM  STRATEGY start","code":"//==============================================================\n//  Alok Jain Style - Multi RSI Momentum\n//  22 / 44 / 66 RSI Average Score\n//==============================================================\n\n_SECTION_BEGIN(\"Alok Jain Multi-RSI Momentum\");\n\n//========== Parameters ==========\n\n// TimeFrameSet(indaily);\n\nRSI1 = Param(\"RSI Period 1 (≈1M)\", 22, 10, 50, 1);\nRSI2 = Param(\"RSI Period 2 (≈2M)\", 44, 20, 80, 1);\nRSI3 = Param(\"RSI Period 3 (≈3M)\", 66, 30, 100, 1);\n\nMinScore     = Optimize(\"Minimum Avg RSI Score\", 68, 60, 73, 1);\nROC_Period   = Optimize(\"ROC Period (for ranking)\", 126, 21, 252, 21);  // ≈6 months\nShowOnlyBuy  = ParamToggle(\"Show Only Buy Signals\", \"No|Yes\", 1);\n\n//========== Calculations ==========\nR1 = RSI(RSI1);\nR2 = RSI(RSI2);\nR3 = RSI(RSI3);\n\n//=========mainindex========\n//positive market trend\n\n\nNC = Foreign( \"NIFTY50\", \"Close\" ) ;\nlongma=Optimize (\"niftylongma\", 200, 50, 200,10);\nshortma=Optimize (\"niftylongma\", 50, 10, 100,10);\n\nMA200NC= MA(NC,longma);\nMA50NC= MA(NC,shortma);\n\n\n\n// Cash call\n\nlongmasell=Optimize (\"niftylongma\", 200, 50, 200,10);\nshortmasell=Optimize (\"niftylongma\", 50, 10, 100,10);\n\nMA200NCsell= MA(NC,longmasell);\nMA50NCsell = MA(NC,shortmasell);\n\n//Cashcall=  Ref(NC,-1) < Ref(MANC,-1) AND  NC < Ref(NC, -1);;\n\n\n\n//TimeFrameRestore();\n\nAvgRSI =((R1)+(R2))/2 ; // (R1 + R2 + R3) / 3;        // Momentum Score\n\nROC_Val = ROC(C, ROC_Period);         // Extra ranking filter\n\n// Strong Momentum Condition\n\nmap= Optimize(\" map \", 55, 50, 75, 1);\nStrongMomentum = AvgRSI > MinScore AND C > MA(C, map);\n\nMaxOpen = Optimize(\"MaxOpen\", 14, 10, 30,1);\n\nSetTradeDelays( 0, 0, 0, 0 );\nSetOption( \"MaxOpenPositions\", MaxOpen );\nSetPositionSize( 100 / MaxOpen, spsPercentOfEquity );\nPositionScore = Ref( AvgRSI, -1 );              // when more signals than slots: strongest first\n\n\n//========== Signals ==========\nPM =  NC > MA50NC And MA50NC > MA200NC;\nCashcall=cross(MA200NCsell,MA50NCsell);\n\nBuySetup = Cross(AvgRSI, MinScore) AND StrongMomentum;\nBuy      = Ref(BuySetup, -1) ; //and Ref(PM, -1);\n\nSell = Cross(MinScore, AvgRSI) OR C < MA(C, 50); //OR Cashcall;   // Simple exit when momentum fades\n\nShort = 0;\nCover = 0;\n\n//========== Plotting ==========\nSetChartOptions(0, chartShowArrows | chartShowDates);\n_N(Title = StrFormat(\"{{NAME}} - AvgRSI: %.1f | ROC: %.1f%%  {{VALUES}}\", \n             SelectedValue(AvgRSI), SelectedValue(ROC_Val)));\n\nPlot(C, \"Close\", colorDefault, styleCandle);\nPlot(MA(C, 50), \"50 MA\", colorYellow, styleThick);\n\n// Momentum Score in separate pane\nPlot(AvgRSI, \"Avg RSI Score\", colorBrightGreen, styleThick | styleOwnScale);\nPlot(MinScore, \"Min Score\", colorRed, styleDashed | styleOwnScale);\n\nPlotShapes(IIf(BuySetup, shapeUpArrow, shapeNone), colorBrightGreen, 0, L, -30);\nPlotShapes(IIf(Sell, shapeDownArrow, shapeNone), colorRed, 0, H, -30);\n\n//========== Exploration (Best for Ranking) ==========\nFilter = AvgRSI > MinScore AND C > MA(C, 50);\n\nAddColumn(AvgRSI, \"Avg RSI Score\", 1.2);\nAddColumn(R1, \"RSI-22\", 1.1);\nAddColumn(R2, \"RSI-44\", 1.1);\nAddColumn(R3, \"RSI-66\", 1.1);\nAddColumn(ROC_Val, \"ROC %\", 1.2);\nAddColumn(C, \"Close\", 1.2);\nAddColumn(MA(C, 50), \"50 MA\", 1.2);\n\n// Sort by Avg RSI or ROC in Exploration window for ranking\nSetSortColumns(-3);   // Highest Avg RSI on top\n\n_SECTION_END();","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKEM","ALKYLAMINE","AMAGI","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","