{"v":1,"id":"mvhqwl7o-ekc7","mode":"optimize","formulaName":"My formula","code":"\n_SECTION_BEGIN(\"SMA Crossover Optimization\");\n\n// Optimize the fast SMA period\nFastPeriod = Optimize(\"Fast SMA\", 50, 20, 200, 1);\nSlowPeriod = Optimize(\"Slow SMA\", 200, 100, 200,1);\nExitPeriod = Optimize(\"Exit SMA\", 100, 20, 200, 1);\n\n\n// Fixed moving averages\nFastSMA = MA(Close, FastPeriod);\nSlowSMA = MA(Close, SlowPeriod);\nExitSMA = MA(Close, ExitPeriod);\n\n// Buy when fast SMA crosses above SMA 200\nBuy = Cross(FastSMA, SlowSMA);\n\n// Sell when closing price falls below SMA 100\nSell = Cross(ExitSMA, Close);\n\n// Remove repeated signals\nBuy = ExRem(Buy, Sell);\nSell = ExRem(Sell, Buy);\n\n\n\n\n// Plot moving averages\nPlot(Close, \"Close\", colorDefault, styleCandle);\nPlot(FastSMA, \"Fast SMA\", colorGreen, styleLine);\nPlot(SlowSMA, \"SMA 200\", colorRed, styleLine);\nPlot(ExitSMA, \"SMA 100\", colorBlue, styleLine);\n\n\n// Exploration columns\nFilter = Buy OR Sell;\nAddColumn(Close, \"Close\", 1.2);\nAddColumn(FastSMA, \"Fast SMA\", 1.2);\nAddColumn(SlowSMA, \"SMA 200\", 1.2);\nAddColumn(ExitSMA, \"SMA 100\", 1.2);\nAddColumn(Buy, \"Buy\", 1.0);\nAddColumn(Sell, \"Sell\", 1.0);\n\n_SECTION_END();","symbols":["360ONE","AADHARHFC","AARTIIND","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABREL","ABSLAMC","ACC","ACE","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","AEGISLOG","AEGISVOPAK","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","ALKEM","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","ANTHEM","ANURAS","APARINDS","APLAPOLLO","APOLLOHOSP","APOLLOTYRE","APTUS","ARE&M","ASAHIINDIA","ASHOKLEY","ASIANPAINT","ASTERDM","ASTRAL","ATGL","ATHERENERG","ATUL","AUBANK","AUROPHARMA","AVANTIFEED","AWL","AXISBANK","AZAD","BAJAJ-AUTO","BAJAJFINSV","BAJAJHFL","BAJAJHLDNG","BAJFINANCE","BALKRISIND","BALRAMCHIN","BANDHANBNK","BANKBARODA","BANKINDIA","BATAINDIA","BBOX","BDL","BEL","BELRISE","BEML","BERGEPAINT","BHARATCOAL"