{"v":1,"id":"mw3k5jip-ttll","mode":"backtest","formulaName":"ALOK_JAIN_MOMENTUM_live_ready","code":"//==============================================================\n//  Alok Jain Style - Multi RSI Momentum   (LIVE-READY version)\n//  Weekly bars. Signals are known at the weekly CLOSE (Friday),\n//  orders are placed for the next week's OPEN (Monday).\n//\n//  Changes against the research version are marked  // CHANGED / // NEW\n//  No Optimize() calls: every number below is a fixed, round value.\n//==============================================================\n_SECTION_BEGIN(\"Alok Jain Multi-RSI Momentum - live\");\n\n//========== Fixed settings (do not optimise these) ==========\nRSI1 = 22;  RSI2 = 44;  RSI3 = 66;\nMinScore = 68;           // CHANGED: Optimize() -> fixed\nMapLen   = 55;           // CHANGED: Optimize() -> fixed (stock must close above its 55-bar average)\nExitMA   = 50;           // the 50-bar average used in the exit\nIdxFast  = 50;  IdxSlow = 200;   // CHANGED: one pair for both market filter and cash call (they were the same numbers)\nMaxOpen  = 14;           // CHANGED: Optimize() -> fixed\n\n// NEW: tradability guard rails (round numbers, not tuned to the backtest)\nMinHistory  = 52;                 // at least 52 weekly bars of history\nMinTurnover = 20000000;           // average weekly traded value >= Rs 2 crore (price x volume, 26-week average)\n\n//========== Calculations ==========\nR1 = RSI(RSI1);\nR2 = RSI(RSI2);\nR3 = RSI(RSI3);                   // shown in the Explore only; the score uses R1 and R2\n\nNC       = Foreign(\"^NIFTY50\", \"Close\");\nMA200NC  = MA(NC, IdxSlow);\nMA50NC   = MA(NC, IdxFast);\n\nAvgRSI   = (R1 + R2) / 2;\nROC_Val  = ROC(C, 126);           // info column only; it is not used in any rule\n\n//========== Tradability (NEW) ==========\nLiquid   = MA(C * V, 26) >= MinTurnover;\nHasHist  = Cum(1) >= MinHistory;\nTradable = Liquid AND HasHist;\n\n//========== Market filter and cash call ==========\nPM       = NC > MA50NC AND MA50NC > MA200NC;\nCashcall = Cross(MA200NC, MA50NC);        // CHANGED: same MAs as the filter (200/50), was a duplicate pair\n\n//========== Signals ==========\nStrongMomentum = AvgRSI > MinScore AND C > MA(C, MapLen);\nBuySetup = Cross(AvgRSI, MinScore) AND StrongMomentum AND Tradable;   // NEW: Tradable\nSellRaw  = Cross(MinScore, AvgRSI) OR C < MA(C, ExitMA) OR Cashcall;\n\n// Trades: the signal is evaluated on the closed bar, the trade happens at the NEXT bar's open.\nSetTradeDelays(0, 0, 0, 0);\nBuyPrice  = Open;  SellPrice = Open;\nBuy  = Ref(BuySetup, -1) AND Ref(PM, -1);\nSell = Ref(SellRaw, -1);          // CHANGED: was SellRaw on the same bar = used the bar's close to sell at its open (look-ahead)\nShort = 0;  Cover = 0;\n\nSetOption(\"MaxOpenPositions\", MaxOpen);\nSetOption(\"PriceBoundChecking\", True);\nSetPositionSize(100 / MaxOpen, spsPercentOfEquity);\nPositionScore = Ref(AvgRSI, -1);          // strongest momentum first when there are more signals than slots\n\n//========== Plotting ==========\nSetChartOptions(0, chartShowArrows | chartShowDates);\n_N(Title = StrFormat(\"{{NAME}} - AvgRSI: %.1f | ROC: %.1f%%  {{VALUES}}\", SelectedValue(AvgRSI), SelectedValue(ROC_Val)));\nPlot(C, \"Close\", colorDefault, styleCandle);\nPlot(MA(C, ExitMA), \"50 MA\", colorYellow, styleThick);\nPlot(AvgRSI, \"Avg RSI Score\", colorBrightGreen, styleThick | styleOwnScale);\nPlot(MinScore, \"Min Score\", colorRed, styleDashed | styleOwnScale);\nPlotShapes(IIf(BuySetup, shapeUpArrow, shapeNone), colorBrightGreen, 0, L, -30);\nPlotShapes(IIf(SellRaw, shapeDownArrow, shapeNone), colorRed, 0, H, -30);\n\n//========== Weekly scan (run on Friday after the close) ==========\n// Buy list for Monday : the rows where  BuyNext = 1 , best Score first.\n// Sell list for Monday: holdings where  SellNext = 1.\nBuyNext  = BuySetup AND PM;\nSellNext = SellRaw;\nFilter = BuyNext OR SellNext;\nAddColumn(BuyNext,  \"BuyNext\", 1);\nAddColumn(SellNext, \"SellNext\", 1);\nAddColumn(AvgRSI,   \"Score\", 1.2);\nAddColumn(PM,       \"Market OK\", 1);\nAddColumn(C,        \"Close\", 1.2);\nAddColumn(MA(C * V, 26) / 10000000, \"Turnover Cr/wk\", 1.1);\nAddColumn(ROC_Val,  \"ROC %\", 1.2);\nSetSortColumns(-5);\n\n_SECTION_END();\n","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKEM","ALKYLAMINE","AMAGI","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","ANTHEM","ANURAS","APARINDS","APLAPOLLO","APOLLO","APOLLOHOSP","APOLLOTYRE","APTUS","ARE&M","ARVIND","ARVINDFASN","ASAHIINDIA","ASHAPURMIN","ASHOKA","ASHOKLEY","ASIANPAINT","ASTERDM","ASTRAL","ASTRAMICRO","ATGL","ATHERENERG","ATLANTAELE","ATUL","AUBANK","AURIONPRO","AUROPHARMA","AVALON","AVANTIFEED","AVL","AWL","AXISBANK","AXISCADES","AZAD","BAJAJ-AUTO","BAJAJCON","BAJAJFINSV","BAJAJHFL","BAJAJHLDNG","BAJFINANCE","BALAMINES","BALKRISIND","BALRAMCHIN","BALUFORGE","BANCOINDIA","BANDHANBNK","BANKBARODA","BANKINDIA","BATAINDIA","BBOX","BDL","BECTORFOOD","BEL","BELRISE","BEML","BERGEPAINT","BHARATCOAL","BHARATFORG","BHARTIARTL","BHARTIHEXA","BHEL","BIOCON","BIRLACORPN","BLACKBUCK","BLS","BLUEJET","BLUESTARCO","BLUESTONE","BORORENEW","BOSCHLTD","BPCL","BRIGADE","BRITANNIA","BSOFT","CAMPUS","CAMS","CANBK","CANFINHOME","CANHLIFE","CAPILLARY","CAPLIPOINT","CARBORUNIV","CARTRADE","CASTROLIND","CCL","CDSL","CEATLTD","CEIGALL","CELLO","CEMPRO","CENTRALBK","CENTUM","CERA","CESC","CGCL","CGPOWER","CHALET","CHAMBLFERT","CHENNPETRO","CHOICEIN","CHOLAFIN","CHOLAHLDNG","CIEINDIA","CIPLA","CLEAN","CLEANMAX","CMPDI","CMRGREEN","CMSINFO","COALINDIA","COCHINSHIP","COFORGE","COHANCE","COLPAL","CONCOR","CONCORDBIO","COROMANDEL","CPPLUS","CRAFTSMAN","CRAMC","CREDITACC","CRISIL","CROMPTON","CSBBANK","CUB"