{"v":1,"id":"mwezaxr3-xcrh","mode":"backtest","formulaName":"T13_stoch_bb_squeeze","code":"// T13  Stochastic + Bollinger squeeze + CCI + Williams %R (written out) + MFI (volume based) + OBV slope.  Tests StochK/StochD, BBandTop/Bot, CCI, HHV/LLV, MFI, OBV, LinRegSlope, Sum, Cum.\nSetOption(\"InitialEquity\", 100000);\nSetOption(\"CommissionMode\", 1);      // percent of trade\nSetOption(\"CommissionAmount\", 1);    // 1% per side\nSetOption(\"UsePrevBarEquityForPosSizing\", True);\nSetTradeDelays(0, 0, 0, 0);\n\nK = StochK(14, 3); D = StochD(14, 3, 3);\nWR = -100 * (HHV(H, 14) - C) / ( HHV(H, 14) - LLV(L, 14) );     // Williams %R\nWidth = (BBandTop(C, 20, 2) - BBandBot(C, 20, 2)) / MA(C, 20);\nSqueeze = Width < LLV(Width, 40) * 1.1;\nGood = CCI(20) > 0 AND WR > -50 AND MFI(14) > 50 AND LinRegSlope(OBV(), 10) > 0;\nBuy  = Cross(K, D) AND Ref(Squeeze, -1) AND Good;\nSell = Cross(D, K) OR WR < -85;\nBuy = ExRem(Buy, Sell); Sell = ExRem(Sell, Buy);\nBuyPrice = SellPrice = O;\nSetTradeDelays(1, 1, 1, 1);\nSetOption(\"MaxOpenPositions\", 20);\nSetPositionSize(5, spsPercentOfEquity);\nPositionScore = CCI(20);\n","symbols":["360ONE","AADHARHFC","AARTIIND","AARTIPHARM","AAVAS","ABB","ABBOTINDIA","ABCAPITAL","ABDL","ABFRL","ABLBL","ABREL","ABSLAMC","ACC","ACE","ACI","ACMESOLAR","ACUTAAS","ADANIENSOL","ADANIENT","ADANIGREEN","ADANIPORTS","ADANIPOWER","ADVENZYMES","AEGISLOG","AEGISVOPAK","AEQUS","AEROFLEX","AETHER","AFCONS","AFFLE","AIAENG","AIIL","AJANTPHARM","AKUMS","ALKEM","ALKYLAMINE","AMAGI","AMBER","AMBUJACEM","ANANDRATHI","ANANTRAJ","ANGELONE","ANTHEM","ANURAS","APARINDS","APLAPOLLO","APOLLO","APOLLOHOSP","APOLLOTYRE","APTUS","ARE&M","ARVIND","ARVINDFASN","ASAHIINDIA","ASHAPURMIN","ASHOKA","ASHOKLEY","ASIANPAINT","ASTERDM","ASTRAL","ASTRAMICRO","ATGL","ATHERENERG","ATLANTAELE","ATUL","AUBANK","AURIONPRO","AUROPHARMA","AVALON","AVANTIFEED","AVL","AWL","AXISBANK","AXISCADES","AZAD","BAJAJ-AUTO","BAJAJCON","BAJAJFINSV","BAJAJHFL","BAJAJHLDNG","BAJFINANCE","BALAMINES","BAL